# ========================================
# 微信订阅号认证系统 - 环境变量配置
# 复制为 .env 后填写。与线上部署环境变量 1:1 对应。
# Nuxt 私有配置统一 NUXT_ 前缀（本地 dev 与 Docker 均生效），
# 公开配置用 NUXT_PUBLIC_ 前缀（构建时内联进客户端）。
# ========================================

# 网站地址（必须，微信回调用）
NUXT_PUBLIC_SITE_URL=https://your-site.com

# 微信后台配置（必须，与公众号后台 Token 一致）
NUXT_WECHAT_TOKEN=your-wechat-token

# Session密钥（必须，生产环境用随机字符串）
# 生成命令：openssl rand -hex 32
NUXT_SESSION_SECRET=dev-secret-change-in-production

# 公众号名称（必须，后端通过 /api/sdk/config 下发给前端 SDK）
NUXT_WECHAT_NAME=神族九帝

# 公众号二维码URL（必须，后端通过 /api/sdk/config 下发给前端 SDK）
NUXT_WECHAT_QRCODE_URL=https://your-site.com/qrcode.jpg

# 微信消息加解密密钥（可选，开启了消息加密才需要）
# NUXT_WECHAT_AES_KEY=your-wechat-aes-key

# 存储类型（固定 turso，唯一后端；设置其他值启动即报错退出，防数据分叉）
STORAGE_TYPE=turso

# Turso 配置（STORAGE_TYPE=turso 时必填）
# 数据库创建后，在 Turso 控制台 Database → 右上角 Generate Token 获取
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=your-turso-token

# 验证码有效期（可选，默认300秒）
# NUXT_CODE_EXPIRY=300

# 关键词配置（可选，JSON格式）
# NUXT_KEYWORDS=["验证码"]

# "验证码"菜单的事件 key（可选，需与公众号后台菜单配置一致）
# NUXT_WECHAT_MENU_KEY=GET_CODE
